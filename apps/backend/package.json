{
  "name": "@bartech/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --builder tsc",
    "dev:worker": "nest start --watch --entryFile worker --builder tsc",
    "build": "nest build --builder tsc",
    "build:worker": "tsc -p tsconfig.build.json && node --check dist/worker.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "openapi:export": "nest build --builder tsc && node dist/export-openapi.js"
  },
  "dependencies": {
    "@bartech/backend-identity": "workspace:*",
    "@bartech/backend-organizations": "workspace:*",
    "@bartech/database": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "16.6.1",
    "ioredis": "5.6.1",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.15.6"
  }
}
