generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Ingredient {
  id Int @id @default(autoincrement())
  name String @unique
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  role Role @default(BARTENDER)
  createdAt DateTime @default(now())
}

enum Role {
  BRAND_BARTENDER
  BAR_MANAGER
  BARTENDER
}