model VenueChecklist {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  venueId      String   @db.Uuid
  authorUserId String?  @db.Uuid
  title        String   @db.VarChar(100)
  steps        String[]
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  venue        Venue    @relation(fields: [venueId, companyId], references: [id, companyId], onDelete: Cascade)
  author       User?    @relation("VenueChecklistAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, venueId, createdAt], map: "venue_checklists_workspace_created_idx")
  @@map("venue_checklists")
}
