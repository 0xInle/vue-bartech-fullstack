enum CompanyRole {
  CHEF_BARTENDER
}

enum VenueRole {
  BARTENDER
  SENIOR_BARTENDER
  BARBACK
  TRAINEE
  BAR_MANAGER
}

enum InitialRegistrationRole {
  CHEF_BARTENDER
  BAR_MANAGER
  SENIOR_BARTENDER
  BARTENDER
}

enum PermissionCode {
  VIEW_PRODUCTS
  VIEW_ARCHIVE
  VIEW_TEAM
  MANAGE_PRODUCTS
  MANAGE_PRODUCT_ARCHIVE
  DELETE_PRODUCTS_PERMANENTLY
  EXPORT_DATA
  INVITE_EMPLOYEES
  INVITE_BAR_MANAGER
  INVITE_CHEF_BARTENDER
  MANAGE_TEAM
  MANAGE_DELEGATED_PERMISSIONS
  CREATE_VENUES
  MANAGE_VENUE
  MANAGE_VENUES
  MANAGE_COMPANY
  VIEW_HISTORY
  VIEW_SCHEDULE
  MANAGE_SCHEDULE
}

enum VenueStatus {
  ACTIVE
}

enum CompanyStatus {
  ACTIVE
  PENDING_CLOSURE
}

enum ProductExportClosureType {
  VENUE
  COMPANY
}

enum ProductExportClosureStatus {
  PREPARING
  PENDING_CLOSURE
  CLOSED
  CANCELLED
}

enum InvitationStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum InvitationPurpose {
  JOIN_EXISTING_VENUE
  JOIN_COMPANY_AS_CHEF
  CREATE_VENUE
}

model Company {
  id                        String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  nameNormalized            String
  initialCreatorUserId      String?                         @db.Uuid
  authorityHistoryKnown     Boolean                         @default(false)
  managementRoleEverPresent Boolean                         @default(true)
  authorityTransferredEver  Boolean                         @default(true)
  status                    CompanyStatus                   @default(ACTIVE)
  closureDeadline           DateTime?                       @db.Timestamptz(6)
  createdAt                 DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                        @updatedAt @db.Timestamptz(6)
  venues                    Venue[]
  memberships               CompanyMembership[]
  initialCreator            User?                           @relation("CompanyInitialCreator", fields: [initialCreatorUserId], references: [id], map: "companies_initial_creator_user_id_fkey")
  invitations               Invitation[]
  auditEvents               AuditEvent[]
  productExports            ProductExportRequest[]
  productExportClosures     ProductExportClosureOperation[]
  supportRequests           SupportRequest[]
  supportAccessGrants       SupportAccessGrant[]

  @@index([status, closureDeadline], map: "companies_status_closure_deadline_idx")
  @@index([initialCreatorUserId], map: "companies_initial_creator_user_id_idx")
  @@map("companies")
}

model Venue {
  id                      String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String                          @db.Uuid
  name                    String
  nameNormalized          String
  status                  VenueStatus                     @default(ACTIVE)
  createdAt               DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                        @updatedAt @db.Timestamptz(6)
  company                 Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships             VenueMembership[]
  temporaryResponsibility TemporaryResponsibility?
  invitations             Invitation[]
  auditEvents             AuditEvent[]
  products                Product[]
  units                   Unit[]
  preparationCategories   PreparationCategory[]
  referenceValues         ReferenceValue[]
  productExports          ProductExportRequest[]
  productExportClosures   ProductExportClosureOperation[]
  supportRequests         SupportRequest[]
  supportAccessGrants     SupportAccessGrant[]
  scheduleTemplates       ScheduleTemplate[]
  schedules               Schedule[]
  scheduleShiftSettings   VenueScheduleShiftSetting[]
  personalReminders       VenuePersonalReminder[]
  announcements           VenueAnnouncement[]
  checklists              VenueChecklist[]

  @@unique([id, companyId], map: "venues_id_company_id_key")
  @@unique([companyId, nameNormalized], map: "venues_company_normalized_name_key")
  @@index([companyId], map: "venues_company_id_idx")
  @@map("venues")
}

model ProductExportClosureOperation {
  id                  String                     @id @default(uuid()) @db.Uuid
  createdByUserId     String                     @db.Uuid
  type                ProductExportClosureType
  status              ProductExportClosureStatus @default(PREPARING)
  companyId           String?                    @db.Uuid
  venueId             String?                    @db.Uuid
  originalCompanyId   String                     @db.Uuid
  originalVenueId     String?                    @db.Uuid
  originalCompanyName String
  originalVenueName   String?
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  closedAt            DateTime?                  @db.Timestamptz(6)
  cancelledAt         DateTime?                  @db.Timestamptz(6)
  createdBy           User                       @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  company             Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  venue               Venue?                     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  exportRequest       ProductExportRequest?

  @@index([originalCompanyId, type, status], map: "product_export_closures_company_status_idx")
  @@index([createdByUserId, createdAt], map: "product_export_closures_author_created_idx")
  @@map("product_export_closure_operations")
}

model CompanyMembership {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @db.Uuid
  companyId        String            @db.Uuid
  companyRole      CompanyRole?
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  endedOn          DateTime?         @db.Date
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  venueMemberships VenueMembership[]

  @@unique([userId, companyId], map: "company_memberships_user_company_key")
  @@index([companyId], map: "company_memberships_company_id_idx")
  @@map("company_memberships")
}

model VenueMembership {
  id                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                        String                    @db.Uuid
  companyId                     String                    @db.Uuid
  venueId                       String                    @db.Uuid
  role                          VenueRole                 @default(BAR_MANAGER)
  hasFullManagementPackage      Boolean                   @default(false)
  fullManagementChangedAt       DateTime?                 @db.Timestamptz(6)
  fullManagementChangedByUserId String?                   @db.Uuid
  startedOn                     DateTime                  @default(dbgenerated("CURRENT_DATE")) @db.Date
  endedOn                       DateTime?                 @db.Date
  createdAt                     DateTime                  @default(now()) @db.Timestamptz(6)
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullManagementChangedBy       User?                     @relation("VenueManagementPackageChangedBy", fields: [fullManagementChangedByUserId], references: [id], map: "venue_memberships_management_package_changed_by_fkey")
  venue                         Venue                     @relation(fields: [venueId, companyId], references: [id, companyId], onDelete: Cascade)
  companyMembership             CompanyMembership         @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade)
  permissionOverrides           VenuePermissionOverride[]
  temporaryResponsibility       TemporaryResponsibility?
  rolePeriods                   VenueRolePeriod[]
  scheduleDays                  ScheduleDay[]
  scheduleAssignment            ScheduleAssignment?
  scheduleSnapshots             ScheduleMemberSnapshot[]

  @@unique([id, venueId], map: "venue_memberships_id_venue_key")
  @@unique([userId, venueId], map: "venue_memberships_one_active_user_venue_key", where: raw("(\"endedOn\" IS NULL)"))
  @@index([companyId, venueId], map: "venue_memberships_company_venue_idx")
  @@index([venueId, hasFullManagementPackage, endedOn], map: "venue_memberships_full_management_package_idx")
  @@map("venue_memberships")
}

model VenueRolePeriod {
  id                String          @id @default(uuid()) @db.Uuid
  venueMembershipId String          @db.Uuid
  role              VenueRole
  startedOn         DateTime        @db.Date
  endedOn           DateTime?       @db.Date
  changedByUserId   String?         @db.Uuid
  reason            String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  membership        VenueMembership @relation(fields: [venueMembershipId], references: [id], onDelete: Cascade, map: "venue_role_periods_membership_fkey")
  changedBy         User?           @relation(fields: [changedByUserId], references: [id], map: "venue_role_periods_changed_by_fkey")

  @@index([venueMembershipId, startedOn], map: "venue_role_periods_membership_start_idx")
  @@map("venue_role_periods")
}

model VenuePermissionOverride {
  id                String          @id(map: "delegated_permissions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueMembershipId String          @db.Uuid
  code              PermissionCode
  enabled           Boolean         @default(true)
  changedByUserId   String          @db.Uuid
  changedAt         DateTime        @default(now()) @db.Timestamptz(6)
  venueMembership   VenueMembership @relation(fields: [venueMembershipId], references: [id], onDelete: Cascade)
  changedBy         User            @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([venueMembershipId, code], map: "venue_permission_overrides_membership_code_key")
  @@index([changedByUserId], map: "venue_permission_overrides_changed_by_idx")
  @@map("venue_permission_overrides")
}

model TemporaryResponsibility {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId           String          @unique(map: "temporary_responsibilities_venue_key") @db.Uuid
  venueMembershipId String          @db.Uuid
  assignedByUserId  String          @db.Uuid
  reason            String
  assignedAt        DateTime        @default(now()) @db.Timestamptz(6)
  venue             Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueMembership   VenueMembership @relation(fields: [venueMembershipId, venueId], references: [id, venueId], onDelete: Cascade, map: "temporary_responsibilities_membership_venue_fkey")
  assignedBy        User            @relation(fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([venueMembershipId, venueId], map: "temporary_responsibilities_membership_venue_key")
  @@index([assignedByUserId], map: "temporary_responsibilities_assigned_by_idx")
  @@map("temporary_responsibilities")
}

model Invitation {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose           InvitationPurpose            @default(JOIN_EXISTING_VENUE)
  companyId         String                       @db.Uuid
  venueId           String?                      @db.Uuid
  email             String
  emailNormalized   String
  role              VenueRole?
  tokenHash         String                       @unique(map: "invitations_token_hash_key")
  createdByUserId   String?                      @db.Uuid
  status            InvitationStatus             @default(ACTIVE)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime                     @db.Timestamptz(6)
  completedAt       DateTime?                    @db.Timestamptz(6)
  closedAt          DateTime?                    @db.Timestamptz(6)
  company           Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  venue             Venue?                       @relation(fields: [venueId, companyId], references: [id, companyId], onDelete: Cascade)
  createdBy         User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptanceSession InvitationAcceptanceSession?

  @@unique([emailNormalized, companyId], map: "invitations_one_open_chef_per_email_company_key", where: raw("((purpose = 'JOIN_COMPANY_AS_CHEF'::\"InvitationPurpose\") AND (status = ANY (ARRAY['ACTIVE'::\"InvitationStatus\", 'IN_PROGRESS'::\"InvitationStatus\"])))"))
  @@unique([emailNormalized, companyId], map: "invitations_one_open_new_venue_per_email_company_key", where: raw("((purpose = 'CREATE_VENUE'::\"InvitationPurpose\") AND (status = ANY (ARRAY['ACTIVE'::\"InvitationStatus\", 'IN_PROGRESS'::\"InvitationStatus\"])))"))
  @@unique([emailNormalized, venueId], map: "invitations_one_open_per_email_venue_key", where: raw("((purpose = 'JOIN_EXISTING_VENUE'::\"InvitationPurpose\") AND (\"venueId\" IS NOT NULL) AND (status = ANY (ARRAY['ACTIVE'::\"InvitationStatus\", 'IN_PROGRESS'::\"InvitationStatus\"])))"))
  @@index([venueId, status, expiresAt], map: "invitations_venue_status_expiry_idx")
  @@index([emailNormalized, venueId], map: "invitations_email_venue_idx")
  @@index([companyId, purpose, status, expiresAt], map: "invitations_company_purpose_status_expiry_idx")
  @@map("invitations")
}

model InvitationAcceptanceSession {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId    String           @unique(map: "invitation_acceptance_sessions_invitation_key") @db.Uuid
  tokenHash       String           @unique(map: "invitation_acceptance_sessions_token_hash_key")
  emailNormalized String
  startedAt       DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime         @db.Timestamptz(6)
  userId          String?          @db.Uuid
  fullName        String?
  passwordHash    String?
  emailVerifiedAt DateTime?        @db.Timestamptz(6)
  invitation      Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges      EmailChallenge[]

  @@index([expiresAt], map: "invitation_acceptance_sessions_expiry_idx")
  @@map("invitation_acceptance_sessions")
}
