enum ScheduleShiftCode {
  MORNING
  DAY
  EVENING
  NIGHT
}

enum ScheduleDayStatus {
  DAY_OFF
  VACATION
  SICK_LEAVE
  NO_SHOW
}

enum ScheduleDateMarkerType {
  INVENTORY
}

model Schedule {
  id          String                   @id @default(uuid()) @db.Uuid
  venueId     String                   @db.Uuid
  year        Int
  month       Int
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)
  venue       Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  days        ScheduleDay[]
  members     ScheduleMemberSnapshot[]
  dateMarkers ScheduleDateMarker[]

  @@unique([venueId, year, month], map: "schedules_venue_month_key")
  @@index([venueId, year, month], map: "schedules_venue_month_idx")
  @@map("schedules")
}

model ScheduleDateMarker {
  id         String                 @id @default(uuid()) @db.Uuid
  scheduleId String                 @db.Uuid
  date       DateTime               @db.Date
  type       ScheduleDateMarkerType
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)
  schedule   Schedule               @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date], map: "schedule_date_markers_schedule_date_key")
  @@map("schedule_date_markers")
}

model ScheduleMemberSnapshot {
  scheduleId        String          @db.Uuid
  venueMembershipId String          @db.Uuid
  fullName          String
  schedule          Schedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  membership        VenueMembership @relation(fields: [venueMembershipId], references: [id], onDelete: Cascade)

  @@id([scheduleId, venueMembershipId])
  @@map("schedule_member_snapshots")
}

model ScheduleDay {
  id                 String                     @id @default(uuid()) @db.Uuid
  scheduleId         String                     @db.Uuid
  venueMembershipId  String                     @db.Uuid
  date               DateTime                   @db.Date
  shiftDurationHours Int?
  shiftCode          ScheduleShiftCode?
  shiftStartMinute   Int?
  shiftSettingId     String?                    @db.Uuid
  status             ScheduleDayStatus?
  updatedByUserId    String                     @db.Uuid
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(6)
  schedule           Schedule                   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  membership         VenueMembership            @relation(fields: [venueMembershipId], references: [id], onDelete: Cascade)
  shiftSetting       VenueScheduleShiftSetting? @relation(fields: [shiftSettingId], references: [id], onDelete: SetNull)
  updatedBy          User                       @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)
  changes            ScheduleDayChange[]
  comment            ScheduleDayComment?

  @@unique([venueMembershipId, date], map: "schedule_days_membership_date_key")
  @@index([scheduleId, date], map: "schedule_days_schedule_date_idx")
  @@index([shiftSettingId], map: "schedule_days_shift_setting_id_idx")
  @@map("schedule_days")
}

model VenueScheduleShiftSetting {
  id                   String            @id @default(uuid()) @db.Uuid
  venueId              String            @db.Uuid
  shiftCode            ScheduleShiftCode
  startMinute          Int
  defaultDurationHours Int
  venue                Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  scheduleDays         ScheduleDay[]

  @@index([venueId, shiftCode], map: "venue_schedule_shift_settings_venue_code_idx")
  @@map("venue_schedule_shift_settings")
}

model ScheduleDayChange {
  id              String      @id @default(uuid()) @db.Uuid
  scheduleDayId   String      @db.Uuid
  oldValue        Json?
  newValue        Json?
  changedByUserId String      @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  scheduleDay     ScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  changedBy       User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([scheduleDayId, createdAt], map: "schedule_day_changes_day_created_idx")
  @@map("schedule_day_changes")
}

model ScheduleDayComment {
  scheduleDayId   String                      @id @db.Uuid
  text            String
  updatedByUserId String                      @db.Uuid
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(6)
  scheduleDay     ScheduleDay                 @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  updatedBy       User                        @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)
  history         ScheduleDayCommentVersion[]

  @@map("schedule_day_comments")
}

model ScheduleDayCommentVersion {
  id              String             @id @default(uuid()) @db.Uuid
  scheduleDayId   String             @db.Uuid
  text            String
  changedByUserId String             @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  comment         ScheduleDayComment @relation(fields: [scheduleDayId], references: [scheduleDayId], onDelete: Cascade)
  changedBy       User               @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([scheduleDayId, createdAt], map: "schedule_comment_versions_day_created_idx")
  @@map("schedule_day_comment_versions")
}

model ScheduleTemplate {
  id               String                    @id @default(uuid()) @db.Uuid
  venueId          String?                   @db.Uuid
  name             String
  isSystem         Boolean                   @default(false)
  currentVersionId String?                   @unique @db.Uuid
  createdByUserId  String?                   @db.Uuid
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(6)
  venue            Venue?                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy        User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions         ScheduleTemplateVersion[] @relation("TemplateVersions")
  currentVersion   ScheduleTemplateVersion?  @relation("CurrentTemplateVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  assignments      ScheduleAssignment[]

  @@index([venueId, isSystem, name], map: "schedule_templates_scope_name_idx")
  @@map("schedule_templates")
}

model ScheduleTemplateVersion {
  id              String                @id @default(uuid()) @db.Uuid
  templateId      String                @db.Uuid
  version         Int
  createdByUserId String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  template        ScheduleTemplate      @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentFor      ScheduleTemplate?     @relation("CurrentTemplateVersion")
  createdBy       User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignments     ScheduleAssignment[]
  days            ScheduleTemplateDay[]

  @@unique([templateId, version], map: "schedule_template_versions_template_version_key")
  @@map("schedule_template_versions")
}

model ScheduleTemplateDay {
  templateVersionId String                  @db.Uuid
  position          Int
  shiftSettingId    String?                 @db.Uuid
  templateVersion   ScheduleTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@id([templateVersionId, position])
  @@map("schedule_template_days")
}

model ScheduleAssignment {
  venueMembershipId String                  @id @db.Uuid
  templateId        String                  @db.Uuid
  templateVersionId String                  @db.Uuid
  cycleAnchorDate   DateTime                @db.Date
  applyFromDate     DateTime                @db.Date
  assignedByUserId  String                  @db.Uuid
  updatedAt         DateTime                @updatedAt @db.Timestamptz(6)
  membership        VenueMembership         @relation(fields: [venueMembershipId], references: [id], onDelete: Cascade)
  template          ScheduleTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion   ScheduleTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  assignedBy        User                    @relation(fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@map("schedule_assignments")
}
